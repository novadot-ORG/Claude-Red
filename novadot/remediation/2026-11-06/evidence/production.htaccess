<IfModule mod_headers.c>
  # 1. Global Security Headers (Applies to all files, pages, and assets)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # finalize-build.mjs adds exact inline-script hashes and the production tracker.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-UXW7jTqYSMRYd+b4QAJXdjT37yknr7MuXQZhWEK06CQ=' 'sha256-b3B1G/lPZUWnX41KFp4d5mQKo82bqJES+i/60DeQ/Is=' 'sha256-hhMTSzWZCqbHblBXNf9+bJr72MAI8mN1zdNMeD9ky+U=' 'sha256-qogyGbPGJJ18sIc2x01iLqtCj1vlSyP+UXQFklDGN5g=' https://scanner.novadot.co.uk/novadot-analytics.v1.072ff0e7fc53.js; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://scanner.novadot.co.uk; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'self';"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # 2. HTML Cache Busting (Only applies to HTML pages so visitors always get fresh builds)
  <FilesMatch "\.(html|htm)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # 3. Static Asset Caching (Optional but recommended: immutable cache for hashed Astro assets)
  <FilesMatch "\.(js|css|woff2|png|svg|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>


Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^about-us/?$ https://novadot.co.uk/about/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^contact-us/?$ https://novadot.co.uk/contact/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^ai-solutions/?$ https://novadot.co.uk/services/software-ai-business-systems/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^enterprise-software/?$ https://novadot.co.uk/services/software-ai-business-systems/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^data-analytics/?$ https://novadot.co.uk/services/software-ai-business-systems/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^erp-implementation/?$ https://novadot.co.uk/services/software-ai-business-systems/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^web-development/?$ https://novadot.co.uk/services/web-mobile-digital-growth/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^mobile-apps/?$ https://novadot.co.uk/services/web-mobile-digital-growth/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^digital-marketing/?$ https://novadot.co.uk/services/web-mobile-digital-growth/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^cloud-services/?$ https://novadot.co.uk/services/cloud-security-it-operations/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^cloud-security/?$ https://novadot.co.uk/services/cloud-security-it-operations/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^backup-recovery/?$ https://novadot.co.uk/services/cloud-security-it-operations/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^it-auditing/?$ https://novadot.co.uk/services/cloud-security-it-operations/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^it-infrastructure/?$ https://novadot.co.uk/services/cloud-security-it-operations/ [R=301,L]
# Preserve the retired WordPress spam-URL response.
RewriteCond %{HTTP_HOST} ^(?:www\.)?novadot\.co\.uk$ [NC]
RewriteRule ^shopdetail(?:/|$) - [G,L]
RewriteCond %{HTTP_HOST} ^www\.novadot\.co\.uk$ [NC]
RewriteRule ^ https://novadot.co.uk%{REQUEST_URI} [R=301,L,NE]
</IfModule>
