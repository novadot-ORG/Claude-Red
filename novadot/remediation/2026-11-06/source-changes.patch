+// Public production integration, copied from the live tag and SRI-verified on
+// 2026-11-05 UTC. This site identifier is public, not an API credential.
+// Keep review builds free of tracking. Update this pin deliberately, together
+// with the deployment evidence and CSP validation; never patch generated HTML.
+export const analytics = Object.freeze({
+  scriptUrl: 'https://scanner.novadot.co.uk/novadot-analytics.v1.072ff0e7fc53.js',
+  integrity: 'sha384-5sIvO4uGVSOkyWi+5uhod+c65rFwppXlcnGxsJSiig2jKQ2Vvn8YtmfbDYCnz1CG',
