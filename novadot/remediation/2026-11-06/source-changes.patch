+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { buildPolicy, scriptHash, policyFromApache, validateDocumentPolicy } from '../scripts/security-policy.mjs';
+import { analytics, analyticsRoutes } from '../config/analytics.mjs';
+
+const page = '<script type="module">document.body.dataset.ready="yes";</script>';
+const tracker = `<script defer src="${analytics.scriptUrl}" integrity="${analytics.integrity}" crossorigin="anonymous" referrerpolicy="no-referrer" data-site="${analytics.siteId}" data-routes="${analyticsRoutes}"></script>`;
+
+test('exact hashes permit original scripts but reject changes and injected scripts', () => {
+  const policy = buildPolicy([page], false);
+  assert.deepEqual(validateDocumentPolicy(page, policy, false), []);
+  for (const mutated of [page.replace('yes', 'no'), page + '<script>alert(1)</script>']) {
+    assert.match(validateDocumentPolicy(mutated, policy, false).join(' '), /exact build hash/);
+  }
+});
+
+test('hash collection includes noindex pages and deduplicates identical scripts', () => {
+  const errorPage = '<meta name="robots" content="noindex, nofollow"><script>window.errorPage=true;</script>';
+  const policy = buildPolicy([page, page, errorPage], false);
+  assert.equal(policy.split(scriptHash('document.body.dataset.ready="yes";')).length - 1, 1);
+  assert.deepEqual(validateDocumentPolicy(errorPage, policy, false), []);
+});
+
+test('unsafe scripts, handlers, URL execution and permissive restrictions fail', () => {
+  const policy = buildPolicy([page], false);
+  for (const source of ["'unsafe-inline'", "'unsafe-eval'", '*', 'https:', 'data:']) {
+    assert.ok(validateDocumentPolicy(page, policy.replace("script-src 'self'", `script-src 'self' ${source}`), false).length);
+  }
+  for (const fragment of ['<button onclick="alert(1)">Test</button>', '<a href="javascript:alert(1)">Test</a>', '<script src="https://unexpected.example/test.js"></script>']) {
+    assert.ok(validateDocumentPolicy(page + fragment, policy, false).length);
+  }
+  for (const directive of ['base-uri', 'object-src', 'form-action', 'frame-ancestors', 'script-src-attr']) {
+    const loosened = policy.replace(new RegExp(`${directive} ([^;]+);`), `${directive} $1 https://unexpected.example;`);
+    assert.match(validateDocumentPolicy(page, loosened, false).join(' '), new RegExp(directive));
+  }
+});
+
+test('production requires exactly one pinned analytics tag; review excludes it', () => {
+  const html = page + tracker;
+  const policy = buildPolicy([html], true);
+  assert.deepEqual(validateDocumentPolicy(html, policy, true), []);
+  for (const mutated of [page, html + tracker, html.replace(analytics.integrity, 'sha384-invalid'), html.replace(analyticsRoutes, '%2Fother')]) {
+    assert.ok(validateDocumentPolicy(mutated, policy, true).length);
+  }
+  assert.ok(validateDocumentPolicy(html, buildPolicy([html], false), false).length);
+  assert.equal(buildPolicy([page], false).includes('scanner.novadot.co.uk'), false);
+});
+
+test('Apache policy must exist exactly once', () => {
+  const header = `Header always set Content-Security-Policy "${buildPolicy([page], false)}"\n`;
+  assert.equal(policyFromApache(header), buildPolicy([page], false));
+  assert.throws(() => policyFromApache(''));
+  assert.throws(() => policyFromApache(header + header));
+});
