+import { createHash } from 'node:crypto';
+import { analytics, analyticsRoutes } from '../config/analytics.mjs';
+
+export function scriptBlocks(html) {
+  return [...html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)].map((match) => {
+    const attributes = Object.fromEntries([...match[1].matchAll(/([\w:-]+)\s*=\s*(?:"([^"]*)"|'([^']*)')/g)]
+      .map((attribute) => [attribute[1].toLowerCase(), attribute[2] ?? attribute[3]]));
+    return { attributes, content: match[2] };
+  });
+}
+export const scriptHash = (content) => `'sha256-${createHash('sha256').update(content, 'utf8').digest('base64')}'`;
+
+export function buildPolicy(documents, production) {
+  const hashes = new Set();
+  for (const html of documents) {
+    for (const { attributes, content } of scriptBlocks(html)) {
+      if (!Object.hasOwn(attributes, 'src') && content.trim()) hashes.add(scriptHash(content));
+    }
+  }
+  // Keep existing inline styles for presentation. Script blocks have exact
+  // build hashes; event-handler attributes and eval are never authorised.
+  return [
+    "default-src 'self'",
+    `script-src 'self' ${[...hashes].sort().join(' ')}${production ? ` ${analytics.scriptUrl}` : ''}`.trim(),
+    "script-src-attr 'none'",
+    "style-src 'self' 'unsafe-inline'",
+    "img-src 'self' data: https:",
+    "font-src 'self'",
+    `connect-src 'self'${production ? ` ${new URL(analytics.scriptUrl).origin}` : ''}`,
+    "base-uri 'none'", "object-src 'none'", "form-action 'self'", "frame-ancestors 'self'",
+  ].join('; ') + ';';
+}
+
+export function policyFromApache(rules) {
+  const policies = [...rules.matchAll(/^\s*Header always set Content-Security-Policy "([^"]+)"\s*$/gm)];
+  if (policies.length !== 1) throw new Error('Expected exactly one generated Content-Security-Policy header.');
+  return policies[0][1];
+}
+
+export function validateDocumentPolicy(html, policy, production) {
+  const errors = [];
+  const directives = new Map(policy.split(';').map((part) => part.trim().split(/\s+/)).filter(([name]) => name).map(([name, ...values]) => [name, values.join(' ')]));
+  const sources = (policy.match(/(?:^|;)\s*script-src\s+([^;]+)/)?.[1] ?? '').split(/\s+/);
+  for (const forbidden of ["'unsafe-inline'", "'unsafe-eval'", '*', 'https:', 'data:']) {
+    if (sources.includes(forbidden)) errors.push(`Unsafe script source: ${forbidden}`);
+  }
+  if (!sources.includes("'self'")) errors.push('Same-origin scripts must be allowed.');
+  for (const [directive, expected] of [['script-src-attr', "'none'"], ['base-uri', "'none'"], ['object-src', "'none'"], ['form-action', "'self'"], ['frame-ancestors', "'self'"]]) {
+    if (directives.get(directive) !== expected) errors.push(`Missing restrictive ${directive}.`);
+  }
+  const scripts = scriptBlocks(html);
+  let trackerCount = 0;
+  for (const { attributes, content } of scripts) {
+    if (Object.hasOwn(attributes, 'src')) {
+      const src = attributes.src;
+      if (src === analytics.scriptUrl && production) {
+        trackerCount++;
+        if (!sources.includes(src)) errors.push('Analytics script is not allowed by CSP.');
+        if (attributes.integrity !== analytics.integrity || attributes.crossorigin !== 'anonymous'
+          || attributes.referrerpolicy !== 'no-referrer' || attributes['data-site'] !== analytics.siteId
+          || attributes['data-routes'] !== analyticsRoutes) errors.push('Analytics attributes differ from the pinned source configuration.');
+      } else if (!src.startsWith('/') || src.startsWith('//')) errors.push(`Unexpected script URL: ${src}`);
+    } else if (content.trim() && !sources.includes(scriptHash(content))) errors.push('Inline script is missing its exact build hash.');
+  }
+  if (trackerCount !== (production ? 1 : 0)) errors.push('Incorrect analytics tag count for this build mode.');
+  const markup = html.replace(/<script\b[^>]*>[\s\S]*?<\/script\s*>/gi, '').replace(/<style\b[^>]*>[\s\S]*?<\/style\s*>/gi, '');
+  if (/<[a-z][^>]*\son[a-z]+\s*=/i.test(markup)) errors.push('Inline event handlers are forbidden.');
+  if (/<[a-z][^>]*\s(?:href|action)\s*=\s*["']\s*javascript:/i.test(markup)) errors.push('JavaScript URLs are forbidden.');
+  return errors;
+}
