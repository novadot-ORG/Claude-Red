<!DOCTYPE html><html lang="en-GB"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="See NovaDot's problem-led approach to technology decisions, bounded delivery, acceptance, support and handover."><meta name="robots" content="index, follow"><link rel="canonical" href="https://novadot.co.uk/how-we-work/"><link rel="icon" type="image/png" href="/brand/novadot-mark.png"><meta name="theme-color" content="#fcfbf8"><meta property="og:type" content="website"><meta property="og:title" content="How We Work | NovaDot"><meta property="og:description" content="See NovaDot's problem-led approach to technology decisions, bounded delivery, acceptance, support and handover."><meta property="og:url" content="https://novadot.co.uk/how-we-work/"><meta property="og:image" content="https://novadot.co.uk/brand/novadot-share-preview.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="NovaDot — Independent systems architecture, custom software, and managed cloud operations"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="How We Work | NovaDot"><meta name="twitter:description" content="See NovaDot's problem-led approach to technology decisions, bounded delivery, acceptance, support and handover."><meta name="twitter:image" content="https://novadot.co.uk/brand/novadot-share-preview.png"><title>How We Work | NovaDot</title><script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"NovaDot","legalName":"NOVADOT LTD","url":"https://novadot.co.uk","logo":"https://novadot.co.uk/brand/novadot-full-logo-hires.png","description":"NovaDot helps UK organisations plan, build, improve and support software, systems and digital services.","email":"hello@novadot.co.uk","telephone":"+44 (0)116 436 1235","address":{"@type":"PostalAddress","streetAddress":"First Floor, 18B Tithe Street","addressLocality":"Leicester","addressRegion":"Leicestershire","postalCode":"LE5 4BN","addressCountry":"GB"}}</script><link rel="stylesheet" href="/_astro/ArcGraphic.DOqw_ipj.css"><style>.stage-ledger[data-astro-cid-uahrdstm]{border-bottom:1px solid var(--rule)}.work-stage[data-astro-cid-uahrdstm]{border-top:1px solid var(--rule);grid-template-columns:minmax(260px,5fr) minmax(320px,7fr);align-items:start;gap:48px;padding-block:48px;display:grid}.work-stage[data-astro-cid-uahrdstm] h2[data-astro-cid-uahrdstm]{font-size:clamp(30px,3vw,42px);line-height:1.12}.work-stage[data-astro-cid-uahrdstm] p[data-astro-cid-uahrdstm],.input-list[data-astro-cid-uahrdstm] li[data-astro-cid-uahrdstm]{color:var(--muted);font-size:17px;line-height:29px}.input-list[data-astro-cid-uahrdstm]{gap:14px;margin:0;padding-left:22px;display:grid}.worksheet-grid[data-astro-cid-uahrdstm]{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:36px;display:grid}.worksheet-card[data-astro-cid-uahrdstm]{background:var(--gallery);border:1px solid var(--rule);border-radius:var(--radius);flex-direction:column;padding:24px;display:flex}.field-number[data-astro-cid-uahrdstm]{color:var(--accent);letter-spacing:.05em;margin-bottom:8px;font-size:13px;font-weight:700}.worksheet-card[data-astro-cid-uahrdstm] h3[data-astro-cid-uahrdstm]{color:var(--plum);margin:0 0 8px;font-size:18px;line-height:1.3}.field-desc[data-astro-cid-uahrdstm]{color:var(--muted);margin:0 0 16px;font-size:14px;line-height:1.5}.field-example[data-astro-cid-uahrdstm]{background:var(--canvas);border:1px solid var(--rule);border-radius:8px;margin-top:auto;padding:14px 16px}.example-label[data-astro-cid-uahrdstm]{text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:4px;font-size:11px;font-weight:700;display:inline-block}.field-example[data-astro-cid-uahrdstm] p[data-astro-cid-uahrdstm]{color:var(--plum);margin:0;font-size:13px;line-height:1.45}.worksheet-footer[data-astro-cid-uahrdstm]{border:1px dashed var(--rule);border-radius:var(--radius);background:var(--canvas);flex-wrap:wrap;justify-content:space-between;align-items:center;gap:24px;margin-top:32px;padding:24px;display:flex}.worksheet-note[data-astro-cid-uahrdstm]{color:var(--muted);max-width:680px;margin:0;font-size:14px;line-height:1.55}.commercial-grid[data-astro-cid-uahrdstm]{grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;margin-top:36px;display:grid}.commercial-card[data-astro-cid-uahrdstm]{background:var(--canvas);border:1px solid var(--rule);border-radius:var(--radius);padding:28px}.commercial-card[data-astro-cid-uahrdstm] h3[data-astro-cid-uahrdstm]{color:var(--plum);margin:0 0 16px;font-size:19px;line-height:1.3}.commercial-list[data-astro-cid-uahrdstm]{color:var(--muted);gap:12px;margin:0;padding-left:18px;font-size:14px;line-height:1.55;display:grid}.commercial-list[data-astro-cid-uahrdstm] strong[data-astro-cid-uahrdstm]{color:var(--ink)}.phasing-list[data-astro-cid-uahrdstm]{color:var(--muted);gap:14px;margin:0;padding:0;font-size:14px;line-height:1.55;list-style:none;display:grid}.phasing-list[data-astro-cid-uahrdstm] li[data-astro-cid-uahrdstm]{gap:3px;display:grid}.phasing-list[data-astro-cid-uahrdstm] strong[data-astro-cid-uahrdstm]{color:var(--plum);font-size:15px}.faq-block[data-astro-cid-uahrdstm]{border-top:1px solid var(--rule);margin-top:48px;padding-top:36px}.faq-block__title[data-astro-cid-uahrdstm]{color:var(--plum);margin:0 0 24px;font-size:22px}.terms-faq[data-astro-cid-uahrdstm]{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin:0;display:grid}.faq-item[data-astro-cid-uahrdstm] dt[data-astro-cid-uahrdstm]{color:var(--ink);margin-bottom:8px;font-size:16px;font-weight:600}.faq-item[data-astro-cid-uahrdstm] dd[data-astro-cid-uahrdstm]{color:var(--muted);margin:0;font-size:14px;line-height:1.55}@media (width<=759px){.work-stage[data-astro-cid-uahrdstm]{grid-template-columns:1fr;gap:18px;padding-block:36px}.worksheet-footer[data-astro-cid-uahrdstm]{flex-direction:column;align-items:flex-start}}
