LElement){let n=[document.querySelector(`.skip-link`),document.querySelector(`main`),document.querySelector(`footer`)].filter(e=>e instanceof HTMLElement),r=e=>{n.forEach(t=>{t.inert=e})},i=(n=!1)=>{let i=e.getAttribute(`aria-expanded`)===`true`;e.setAttribute(`aria-expanded`,`false`),e.setAttribute(`aria-label`,`Open navigation menu`),t.hidden=!0,document.body.classList.remove(`menu-open`),r(!1),n&&i&&e.focus()};e.addEventListener(`click`,()=>{let n=e.getAttribute(`aria-expanded`)!==`true`;e.setAttribute(`aria-expanded`,String(n)),e.setAttribute(`aria-label`,n?`Close navigation menu`:`Open navigation menu`),t.hidden=!n,document.body.classList.toggle(`menu-open`,n),r(n)}),t.querySelectorAll(`a`).forEach(e=>e.addEventListener(`click`,()=>i())),document.addEventListener(`keydown`,n=>{if(n.key===`Escape`&&i(!0),n.key===`Tab`&&e.getAttribute(`aria-expanded`)===`true`){let r=[e,...t.querySelectorAll(`a`)],i=r[0],a=r.at(-1);n.shiftKey&&document.activeElement===i?(n.preventDefault(),a?.focus()):!n.shiftKey&&document.activeElement===a&&(n.preventDefault(),i.focus())}}),window.matchMedia(`(min-width: 960px)`).addEventListener(`change`,e=>{e.matches&&i()})}</script><main id="main-content"><section class="page-hero"><div class="shell page-hero__grid"><div class="page-hero__copy"><p class="eyebrow">About NovaDot</p><h1>Practical technology decisions, followed by accountable delivery.</h1><p class="page-hero__lead">NovaDot is a Leicester-based technology company. We help UK businesses and community organisations build, connect and support software, websites and business systems. We start with the work your team needs to do, then agree a practical scope and support arrangements.</p></div><div class="page-hero__graphic"><svg class="arc-graphic arc-graphic--compact" viewBox="0 0 620 620" fill="none" aria-hidden="true" focusable="false"><g stroke="currentColor" stroke-width="1.25"><path d="M598 76C400 76 238 184 238 316s162 228 360 228" opacity=".16"></path><path d="M598 116C426 116 286 205 286 316s140 188 312 188" opacity=".24"></path><path d="M598 158C454 158 337 228 337 316s117 146 261 146" opacity=".38"></path><path d="M598 201C485 201 392 252 392 316s93 103 206 103" opacity=".62"></path><path d="M598 245C516 245 448 277 448 316s68 60 150 60"></path><path d="M83 316H448" opacity=".5"></path></g><circle cx="448" cy="316" r="7" fill="currentColor"></circle></svg></div></div></section><section class="content-section" aria-labelledby="company-facts-title" data-astro-cid-ta2fbyqs><div class="shell content-grid" data-astro-cid-ta2fbyqs><p class="content-grid__aside" data-astro-cid-ta2fbyqs>Registration</p><div class="prose" data-astro-cid-ta2fbyqs><h2 id="company-facts-title" data-astro-cid-ta2fbyqs>Company facts</h2><p data-astro-cid-ta2fbyqs>NOVADOT LTD is an active private limited company registered in England and Wales under company number 07691369. It was incorporated on 4 July 2011.</p></div></div></section><section class="content-section" aria-labelledby="community-title" data-astro-cid-ta2fbyqs><div class="shell content-grid" data-astro-cid-ta2fbyqs><p class="content-grid__aside" data-astro-cid-ta2fbyqs>Community</p><div class="prose" data-astro-cid-ta2fbyqs><h2 id="community-title" data-astro-cid-ta2fbyqs>Supporting Midlands small businesses &amp; local AI infrastructure</h2><p data-astro-cid-ta2fbyqs>We work closely with local small businesses across Leicester and the wider Midlands to raise their operational standards, modernise legacy workflows and build reliable digital systems. Alongside commercial delivery, we are committed to providing practical AI infrastructure and accessible technology capabilities to our local community—helping organisations adopt modern tools safely, transparently and effectively.</p><p data-astro-cid-ta2fbyqs>If you are looking to modernise your operations or explore how practical technology and bounded AI can support your organisation, we welcome open conversations.</p><div class="about-action" data-astro-cid-ta2fbyqs><a class="button button--primary" href="/contact/" data-astro-cid-ta2fbyqs>Discuss your project</a></div></div></div></section><section class="content-section content-section--porcelain" aria-labelledby="expectations-title" data-astro-cid-ta2fbyqs><div class="shell content-grid" data-astro-cid-ta2fbyqs><p class="content-grid__aside" data-astro-cid-ta2fbyqs>Standards</p><div class="prose" data-astro-cid-ta2fbyqs><h2 id="expectations-title" data-astro-cid-ta2fbyqs>What clients can expect</h2><ul class="expectation-list" data-astro-cid-ta2fbyqs><li data-astro-cid-ta2fbyqs>One defined problem and decision owner.</li><li data-astro-cid-ta2fbyqs>Honest comparison of lower-risk options.</li><li data-astro-cid-ta2fbyqs>Explicit scope, responsibilities and acceptance.</li><li data-astro-cid-ta2fbyqs>A clear explanation of what we can deliver and when specialist help is needed.</li><li data-astro-cid-ta2fbyqs>Support and handover agreed rather than assumed.</li></ul></div></div></section><section class="closing-cta"><svg class="arc-graphic arc-graphic--compact closing-cta__arc" viewBox="0 0 620 620" fill="none" aria-hidden="true" focusable="false"><g stroke="currentColor" stroke-width="1.25"><path d="M598 76C400 76 238 184 238 316s162 228 360 228" opacity=".16"></path><path d="M598 116C426 116 286 205 286 316s140 188 312 188" opacity=".24"></path><path d="M598 158C454 158 337 228 337 316s117 146 261 146" opacity=".38"></path><path d="M598 201C485 201 392 252 392 316s93 103 206 103" opacity=".62"></path><path d="M598 245C516 245 448 277 448 316s68 60 150 60"></path><path d="M83 316H448" opacity=".5"></path></g><circle cx="448" cy="316" r="7" fill="currentColor"></circle></svg><div class="shell closing-cta__inner"><h2>Talk to NovaDot about your project.</h2><a class="button button--primary" href="/contact/">Discuss your project</a></div></section></main><footer class="site-footer" data-astro-cid-nns7i3if><div class="shell footer-grid" data-astro-cid-nns7i3if><div class="footer-brand" data-astro-cid-nns7i3if><a class="brand-link" href="/" aria-label="NovaDot home" data-astro-cid-nns7i3if><img class="brand-logo" src="/brand/novadot-full-logo-dark-theme.png" srcset="/brand/novadot-full-logo-dark-theme.png 1x, /brand/novadot-full-logo-dark-theme-2x.png 2x" width="720" height="280" alt="NovaDot" data-astro-cid-nns7i3if></a><p data-astro-cid-nns7i3if>NovaDot helps UK organisations plan, build, improve and support software, systems and digital services.</p></div><div class="footer-links" data-astro-cid-nns7i3if><div data-astro-cid-nns7i3if><h2 data-astro-cid-nns7i3if>Work</h2><a href="/services/" data-astro-cid-nns7i3if>Services</a></div><div data-astro-cid-nns7i3if><h2 data-astro-cid-nns7i3if>Company</h2><a href="/events/" data-astro-cid-nns7i3if>Events &amp; Space</a><a href="/how-we-work/" data-astro-cid-nns7i3if>How We Work</a><a href="/about/" data-astro-cid-nns7i3if>About</a></div><div data-astro-cid-nns7i3if><h2 data-astro-cid-nns7i3if>Contact</h2><a href="/contact/" data-astro-cid-nns7i3if>Contact</a></div><div data-astro-cid-nns7i3if><h2 data-astro-cid-nns7i3if>Legal</h2><a href="/privacy-policy/" data-astro-cid-nns7i3if>Privacy Policy</a><a href="/terms/" data-astro-cid-nns7i3if>Terms</a></div></div></div><div class="shell footer-legal" data-astro-cid-nns7i3if><p data-astro-cid-nns7i3if>© 2026 NOVADOT LTD. Registered in England and Wales. Company number 07691369.</p></div></footer></body></html>