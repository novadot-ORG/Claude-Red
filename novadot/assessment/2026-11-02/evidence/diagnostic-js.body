var e={systems:[{id:`spreadsheets`,label:`Spreadsheets & manual emails`,description:`Orders, inventory, or billing handled manually with repeated data entry.`},{id:`legacy-erp`,label:`An older ERP or standalone database`,description:`Systems like older Sage, Access, or on-prem tools that are difficult to adapt.`},{id:`siloed-saas`,label:`Business tools that do not share information`,description:`Separate subscription tools where operational and customer data do not synchronise.`}],digital:[{id:`legacy-cms`,label:`Outdated CMS or corporate site`,description:`Slow loading, difficult to update or lacking clear lead capture.`},{id:`portal`,label:`Member or customer self-service portal`,description:`Users struggle to register, renew, view orders or manage account details online.`},{id:`mobile-web`,label:`A mobile journey that is difficult to complete`,description:`High drop-off or stalled transactions on mobile devices.`}],operations:[{id:`unclear-hosting`,label:`Recovery arrangements are unclear or untested`,description:`No documented server configurations, tested backups or clear recovery steps.`},{id:`cloud-costs`,label:`Cloud costs are unclear or rising`,description:`Infrastructure spend is growing without clear visibility of resource utilisation.`},{id:`support-gap`,label:`No agreed application support service`,description:`Dependent on former contractors or team members who have moved on.`}]},t={systems:{spreadsheets:{title:`Understand the workflow first`,summary:`Review how information moves through the team before choosing software.`,step:`Map the key steps, repeated entries, approvals and reporting needs; agree the review’s scope and timing.`,avoid:`Compare improvements to the current process with software options before making a long-term commitment.`,contactQuery:`workflow-review`},"legacy-erp":{title:`Compare improvements and replacement options`,summary:`An older system may need targeted changes, integration or replacement.`,step:`Check support status, current requirements, data quality and dependencies; compare supported options, including Odoo where relevant.`,avoid:`Understand the costs, migration checks and important business requirements before choosing a platform.`,contactQuery:`systems-evaluation`},"siloed-saas":{title:`Review how your systems share information`,summary:`A supported connection may reduce repeated entry, but the right approach depends on the systems and data involved.`,step:`Identify one troublesome handover and check available integrations, ownership, data rules and failure handling.`,avoid:`Compare built-in connectors, process changes and custom integration before commissioning a build.`,contactQuery:`systems-integration`}},digital:{"legacy-cms":{title:`Review the website before choosing a rebuild`,summary:`Performance, content and maintenance problems can have different causes.`,step:`Check page performance, accessibility, editing needs, integrations and support before comparing repairs or a replacement.`,avoid:`Agree measurable goals and ongoing maintenance responsibilities; choose an architecture after the review.`,contactQuery:`website-review`},portal:{title:`Make the main member or customer task easier`,summary:`Start with the task people most need to complete, such as joining, renewing or checking an order.`,step:`Walk through the current journey on relevant devices and agree usability, access and security requirements.`,avoid:`Test proposed changes with the people who use the service before expanding the feature list.`,contactQuery:`portal-review`},"mobile-web":{title:`Find where the mobile journey breaks down`,summary:`Loading delays, unclear content, form problems or backend failures may affect mobile users.`,step:`Use representative devices, journey testing and performance evidence to identify the cause.`,avoid:`Compare targeted improvements with wider web or app changes against the actual user need.`,contactQuery:`mobile-journey`}},operations:{"unclear-hosting":{title:`Clarify ownership and recovery arrangements`,summary:`A review can establish who controls the environment and what recovery evidence is available.`,step:`Document responsibilities, access, backup coverage and existing recovery procedures; agree any recovery test separately.`,avoid:`Check that recovery plans and responsibilities match how the service is used.`,contactQuery:`hosting-recovery`},"cloud-costs":{title:`Understand what is driving cloud costs`,summary:`Compare the bill with the services, capacity and reliability your organisation needs.`,step:`Inspect usage, ownership, commitments and demand; identify options and assess their effect before changing resources.`,avoid:`Agree cost alerts and verify that proposed savings preserve required capacity and recovery arrangements.`,contactQuery:`cloud-costs`},"support-gap":{title:`Plan an application support handover`,summary:`Begin by understanding the application, access, ownership and existing support arrangements.`,step:`Assess available documentation, code, dependencies and service needs, then agree onboarding and support scope.`,avoid:`Confirm coverage, response expectations, responsibilities and exit arrangements before relying on a new support service.`,contactQuery:`support-handover`}}},n=document.querySelector(`[data-diagnostic-root]`);if(n){let r=``,i=``,a=n.querySelectorAll(`[data-step-indicator]`),o=n.querySelectorAll(`[data-step-panel]`),s=n.querySelector(`[data-setup-options]`),c=n.querySelector(`[data-diagnostic-announce]`),l=1,u=e=>{l=e,o.forEach(t=>{t.getAttribute(`data-step-panel`)===String(e)?(t.removeAttribute(`hidden`),t.querySelector(`h3`)?.focus()):t.setAttribute(`hidden`,``)}),a.forEach(t=>{let n=Number(t.getAttribute(`data-step-indicator`)),r=n===e,i=n<e;t.classList.toggle(`active`,r),t.classList.toggle(`completed`,i),r?t.setAttribute(`aria-current`,`step`):t.removeAttribute(`aria-current`),t instanceof HTMLButtonElement&&(t.disabled=n>e)}),c&&(c.textContent=`Diagnostic step ${e} displayed.`)};a.forEach(e=