o-cid-hf4niqp3] h3[data-astro-cid-hf4niqp3]{color:var(--plum);margin:0 0 20px;font-size:18px}.support-scope-grid[data-astro-cid-hf4niqp3]{grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:24px;min-width:0;display:grid}.scope-col[data-astro-cid-hf4niqp3] h4[data-astro-cid-hf4niqp3]{text-transform:uppercase;letter-spacing:.05em;color:var(--ink);margin:0 0 12px;font-size:14px;font-weight:700}.scope-col[data-astro-cid-hf4niqp3] ul[data-astro-cid-hf4niqp3]{color:var(--muted);gap:10px;margin:0;padding-left:18px;font-size:14px;line-height:1.5;display:grid}.scope-col[data-astro-cid-hf4niqp3] strong[data-astro-cid-hf4niqp3]{color:var(--ink)}.deliverable-spec-card[data-astro-cid-hf4niqp3]{background:var(--gallery);border:1px solid var(--rule);border-radius:var(--radius);gap:20px;min-width:0;margin-top:24px;padding:28px;display:grid}.spec-block[data-astro-cid-hf4niqp3]{gap:6px;display:grid}.spec-block--boundary[data-astro-cid-hf4niqp3]{border-top:1px dashed var(--rule);padding-top:14px}.spec-label[data-astro-cid-hf4niqp3]{text-transform:uppercase;letter-spacing:.05em;color:var(--accent);font-size:11px;font-weight:700}.spec-list[data-astro-cid-hf4niqp3]{color:var(--muted);gap:8px;margin:4px 0 0;padding-left:18px;font-size:14px;line-height:1.5;display:grid}.spec-list[data-astro-cid-hf4niqp3] strong[data-astro-cid-hf4niqp3]{color:var(--ink)}.spec-actions[data-astro-cid-hf4niqp3]{margin-top:8px}@media (width<=639px){.onboarding-card[data-astro-cid-hf4niqp3],.support-scope-summary[data-astro-cid-hf4niqp3],.deliverable-spec-card[data-astro-cid-hf4niqp3]{padding:18px 16px}.onboarding-grid[data-astro-cid-hf4niqp3],.support-scope-grid[data-astro-cid-hf4niqp3]{grid-template-columns:1fr}}
